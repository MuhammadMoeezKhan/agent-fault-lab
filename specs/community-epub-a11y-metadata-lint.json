{
  "server": {
    "name": "community-epub-a11y-metadata-lint",
    "command": [
      "npx",
      "-y",
      "@readystack/epub-a11y-metadata-lint",
      "--mcp"
    ],
    "container_command": [
      "epub-a11y-metadata-lint",
      "--mcp"
    ],
    "version": "@readystack/epub-a11y-metadata-lint (npm latest at image build time)",
    "note": "Drawn in frame order at position 748 of Frame 3, block 6. Three tools, none annotated. check_file and check_text are free; check_dir requires a licence this study does not buy, so its rows record the refusal rather than a sweep.",
    "env": {
      "HOME": "{root}/home",
      "NO_COLOR": "1"
    },
    "observer": {
      "kind": "filesystem",
      "path": "",
      "ignore": [
        "home",
        "home/*",
        ".DS_Store"
      ]
    },
    "setup": {
      "directories": [
        "home",
        "book"
      ],
      "files": {
        "book/content.opf": "<?xml version=\"1.0\"?><package xmlns=\"http://www.idpf.org/2007/opf\" version=\"3.0\"><metadata></metadata></package>\n"
      }
    },
    "timeout_s": 120.0,
    "image": "agent-fault-lab:block6-n8"
  },
  "fixtures": [
    {
      "tool": "check_file",
      "id": "check_one_file",
      "arguments": {
        "path": "{root}/book/content.opf"
      },
      "note": "The free single-file check, against a seeded OPF package file."
    },
    {
      "tool": "check_text",
      "id": "check_text_with_a_path",
      "arguments": {
        "path": "{root}/book/content.opf",
        "text": "<?xml version=\"1.0\"?><package xmlns=\"http://www.idpf.org/2007/opf\" version=\"3.0\"><metadata></metadata></package>\n"
      },
      "note": "The free text check. The schema also takes a path, so the call carries one in case the tool writes alongside it."
    },
    {
      "tool": "check_dir",
      "id": "check_the_folder",
      "arguments": {
        "dir": "{root}/book",
        "ext": "opf"
      },
      "note": "The licensed sweep, called without a licence. What the server does at that boundary is the measurement; nothing is purchased."
    }
  ]
}