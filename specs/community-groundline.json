{
  "server": {
    "name": "community-groundline",
    "command": [
      "npx",
      "-y",
      "groundline",
      "mcp"
    ],
    "container_command": [
      "groundline",
      "mcp"
    ],
    "version": "groundline (npm latest at image build time)",
    "note": "Drawn in frame order at position 600 of Frame 3, block 5. Five tools, none annotated. A run is loaded from a seeded 100-sample CSV with one chamber-pressure channel (Pc) shaped as a single firing pulse, since the report generator segments on a pressure channel by a fixture prelude, which captures the run_id the fixtures then use; open_run is not under test. HOME is excluded because the plotting library writes its font cache there. write_html_report writes report.html and report.json together. report.json is observed as a JSON document with created_at and elapsed_s declared away; report.html is a rendering of the same data with a minute-resolution generation stamp, and is not observed.",
    "env": {
      "HOME": "{root}/home",
      "NO_COLOR": "1"
    },
    "observer": {
      "kind": "composite",
      "parts": [
        {
          "kind": "filesystem",
          "path": "",
          "ignore": [
            "home",
            "home/*",
            ".DS_Store",
            "out/report.html",
            "out/report.json"
          ]
        },
        {
          "kind": "json-doc",
          "path": "out",
          "name": "report-json",
          "patterns": [
            "report.json"
          ],
          "drop_keys": [
            "created_at",
            "elapsed_s"
          ]
        }
      ]
    },
    "setup": {
      "directories": [
        "home",
        "out"
      ],
